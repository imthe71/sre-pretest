# Copy to values.env and replace values with values emitted by Terraform.
APP_REPLICAS=2
MYSQL_REPLICAS=2
APP_IMAGE=YOUR_REGISTRY/YOUR_APP:TAG
APP_CONTAINER_PORT=8080
MYSQL_IMAGE=mysql:8.4
DOMAIN_NAME=app.example.com
APP_PVC_SIZE=5Gi
MYSQL_PVC_SIZE=20Gi
EFS_FILE_SYSTEM_ID=fs-REPLACE_ME
AWS_REGION=ap-northeast-1
# Required only when rendering app-ingress.tls.example.yaml.
ACM_CERTIFICATE_ARN=arn:aws:acm:ap-northeast-1:123456789012:certificate/REPLACE_ME
